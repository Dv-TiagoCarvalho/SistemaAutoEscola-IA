# Copie para .env e troque os valores. Nunca suba o .env para o GitHub.
DB_USER=autoescola
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
CORS_ORIGINS=http://localhost:8081
# Usuário dono da plataforma, criado na primeira subida
SUPERADMIN_EMAIL=super@cfc.local
SUPERADMIN_SENHA=Senha@123
# true = cria 2 autoescolas de exemplo. Só para desenvolvimento.
SEED_EXEMPLO=true
